{
  "verify": [
    {
      "name": "shared code in sync",
      "run": "python tools/sync_shared.py --check"
    },
    {
      "name": "docs",
      "run": "python packs/core/scripts/docs_check.py ."
    },
    {
      "name": "tests",
      "run": "python -m pytest -q tests",
      "timeout": 900
    },
    {
      "name": "validate marketplace",
      "run": "claude plugin validate --strict ."
    },
    {
      "name": "validate core",
      "run": "claude plugin validate --strict packs/core"
    },
    {
      "name": "validate godot",
      "run": "claude plugin validate --strict packs/godot"
    },
    {
      "name": "validate deps",
      "run": "claude plugin validate --strict packs/deps"
    },
    {
      "name": "validate brief",
      "run": "claude plugin validate --strict packs/brief"
    },
    {
      "name": "validate audit",
      "run": "claude plugin validate --strict packs/audit"
    },
    {
      "name": "plugin scan",
      "run": "python packs/audit/scripts/plugin_scan.py --path packs/core --path packs/godot --path packs/deps --path packs/brief --path packs/audit"
    }
  ]
}
