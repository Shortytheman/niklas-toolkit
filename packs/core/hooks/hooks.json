{
  "description": "Stop a git commit or push that would publish a secret or a commit message the user has forbidden.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/commit_guard.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
